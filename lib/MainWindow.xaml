<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="CyberArk Platform Variant Importer"
        Width="1240" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <x:Array x:Key="SettingOperations" Type="sys:String">
      <sys:String>replace</sys:String>
      <sys:String>remove</sys:String>
    </x:Array>

    <SolidColorBrush x:Key="Accent" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Line" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Ink" Color="#111827"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Foreground" Value="#374151"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="MinRowHeight" Value="26"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="CellEdit" TargetType="TextBox">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="#047857"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Would run"><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Skipped"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#B45309"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel>
        <TextBlock x:Name="SettingsPathText" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
        <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="MainTabs" Margin="10,10,10,8" Padding="12" Background="#F3F4F6" BorderBrush="#E5E7EB">

      <!-- ============================ Import ============================ -->
      <TabItem x:Name="ImportTab" Header="  Import  " FontSize="14">
        <Grid TextElement.FontSize="13">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel x:Name="ImportInputs">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="1  PVWA connection" Style="{StaticResource SectionTitle}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PVWA address" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PvwaUrlBox" Grid.Row="0" Grid.Column="1" ToolTip="For example https://pvwa.company.com - a trailing /PasswordVault is ignored."/>

                    <TextBlock Grid.Row="2" Text="Authentication" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AuthTypeBox" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Grid.Row="4" Text="User name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Grid.Row="6" Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Grid.Row="6" Grid.Column="1" ToolTip="Used for this session only. It is never written to disk."/>

                    <Grid x:Name="OtpRow" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="One-time code" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="OtpBox" Grid.Column="1" ToolTip="RADIUS one-time passcode. Leave empty for push approval or password-only RADIUS."/>
                      <ComboBox x:Name="OtpModeBox" Grid.Column="3" ToolTip="How the passcode is sent: appended to the password, or as the answer to a RADIUS challenge."/>
                    </Grid>
                  </Grid>

                  <UniformGrid Columns="2" Margin="0,8,0,0">
                    <CheckBox x:Name="ConcurrentBox" Content="Allow a concurrent session"
                              ToolTip="Keeps your browser session in PVWA alive while this tool is logged on with the same user."/>
                    <CheckBox x:Name="SkipCertBox" Content="Skip TLS certificate check"
                              ToolTip="Only for lab environments with a self-signed certificate."/>
                  </UniformGrid>
                  <DockPanel Margin="0,8,0,0">
                    <Button x:Name="TestConnectionButton" DockPanel.Dock="Right" Content="Test connection"/>
                    <TextBlock Style="{StaticResource Hint}" Text="The password is never saved. Everything else on this page is remembered." Margin="0,0,10,0"/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="2  Source platform" Style="{StaticResource SectionTitle}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="8"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Platform ZIP" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ZipPathBox" Grid.Column="1"/>
                    <Button x:Name="BrowseZipButton" Grid.Column="3" Content="Browse..."/>
                    <TextBlock x:Name="PackageInfoText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Pick the platform package exported from PVWA or downloaded from the Marketplace."/>
                    <TextBlock Grid.Row="3" Text="Platform ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SourceIdBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ToolTip="Filled in from the ZIP. Leave empty to always use the ID found in the ZIP."/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="3  Variants to create" Style="{StaticResource SectionTitle}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Configuration" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ConfigPathBox" Grid.Column="1"/>
                    <Button x:Name="BrowseConfigButton" Grid.Column="3" Content="Browse..."/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                      <Button x:Name="EditConfigButton" DockPanel.Dock="Right" Content="Open in editor" Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                      <TextBlock x:Name="ConfigSummaryText" Style="{StaticResource Hint}" Text="Pick a JSON file, or build one on the Platform editor tab."/>
                    </DockPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="4  Run" Style="{StaticResource SectionTitle}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Report folder" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ReportFolderBox" Grid.Column="1" ToolTip="A CSV report and a log file are written here for every run."/>
                    <Button x:Name="BrowseReportButton" Grid.Column="3" Content="Browse..."/>
                  </Grid>
                  <UniformGrid Columns="2" Margin="0,8,0,0">
                    <CheckBox x:Name="DryRunBox" Content="Dry run (change nothing)"
                              ToolTip="Logs on, checks what already exists and reports what would be created or changed. Nothing is changed in the Vault."/>
                    <CheckBox x:Name="ContinueBox" Content="Continue after a failure"
                              ToolTip="Carry on with the next platform when one fails. When unchecked, the run stops at the first failure."/>
                  </UniformGrid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="3*" MinHeight="120"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="2*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="ValidateButton" Content="Validate" Margin="0,0,8,0" ToolTip="Check the ZIP and the configuration without logging on."/>
                  <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" IsEnabled="False" ToolTip="Stops before the next platform. The one in progress is finished first."/>
                  <Button x:Name="RunButton" Content="Run import" Style="{StaticResource PrimaryButton}" MinWidth="120" MinHeight="32"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ProgressText" Text="Not started." Margin="0,0,0,5"/>
                  <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Accent}" Background="#E5E7EB" BorderThickness="0"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <DataGrid x:Name="ResultsGrid" Grid.Row="1" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Platform ID" Binding="{Binding PlatformId}" Width="170" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding PlatformName}" Width="160" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource StatusText}"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}">
                  <DataGridTextColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                      <Setter Property="ToolTip" Value="{Binding Message}"/>
                    </Style>
                  </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Sec" Binding="{Binding Duration}" Width="55" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

            <Border Grid.Row="3" Background="#111827" CornerRadius="6" Padding="2">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,8,2">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenReportButton" Content="Open report folder" Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                    <Button x:Name="ClearLogButton" Content="Clear" Style="{StaticResource SmallButton}"/>
                  </StackPanel>
                  <TextBlock Text="Log" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                </DockPanel>
                <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#D1D5DB"
                             FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" Padding="6,2">
                  <RichTextBox.Resources>
                    <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
                  </RichTextBox.Resources>
                  <FlowDocument PagePadding="0"><Paragraph x:Name="LogParagraph"/></FlowDocument>
                </RichTextBox>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============================ Editor ============================ -->
      <TabItem x:Name="EditorTab" Header="  Platform editor  " FontSize="14">
        <Grid TextElement.FontSize="13">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card}" Padding="10,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="EditorNewButton" Content="New" Margin="0,0,6,0"/>
                <Button x:Name="EditorOpenButton" Content="Open..." Margin="0,0,6,0"/>
                <Button x:Name="EditorSaveButton" Content="Save" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="EditorSaveAsButton" Content="Save as..." Margin="0,0,14,0"/>
              </StackPanel>
              <Button x:Name="EditorUseButton" DockPanel.Dock="Right" Content="Use this file for the import" Margin="14,0,0,0"/>
              <TextBlock x:Name="EditorFileText" Text="New configuration (not saved yet)" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*" MinWidth="380"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="330" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- list of variants -->
            <Border Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="PlatformCountText" Text="Variants" Style="{StaticResource SectionTitle}"/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                  <Button x:Name="PlatformAddButton" Content="Add" Margin="0,0,3,0" Padding="4,0" Style="{StaticResource PrimaryButton}"/>
                  <Button x:Name="PlatformDuplicateButton" Content="Duplicate" Margin="3,0" Padding="4,0" ToolTip="Copy the selected variant, including its settings and PSM configuration."/>
                  <Button x:Name="PlatformRemoveButton" Content="Remove" Margin="3,0,0,0" Padding="4,0"/>
                </UniformGrid>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                  <Button x:Name="PlatformUpButton" Content="Move up" Margin="0,0,3,0" Style="{StaticResource SmallButton}"/>
                  <Button x:Name="PlatformDownButton" Content="Move down" Margin="3,0,0,0" Style="{StaticResource SmallButton}"/>
                </UniformGrid>
                <ListBox x:Name="PlatformList" BorderBrush="{StaticResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              </DockPanel>
            </Border>

            <!-- details of the selected variant -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
              <Grid>
                <TextBlock x:Name="EditorEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource Hint}" FontSize="13"
                           Text="No variant selected.&#x0a;&#x0a;Choose Add to create the first one, or Open to load an existing file."/>
                <ScrollViewer x:Name="EditorDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                  <StackPanel Margin="14,12">
                    <TextBlock Text="Platform" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Platform ID" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="EdIdBox" Grid.Column="1" ToolTip="Unique ID of the new platform. No spaces."/>
                      <TextBlock Grid.Row="2" Text="Platform name" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="EdNameBox" Grid.Row="2" Grid.Column="1" ToolTip="Display name shown in PVWA."/>
                      <TextBlock Grid.Row="4" Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                      <TextBox x:Name="EdDescriptionBox" Grid.Row="4" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="96"
                               VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                      <TextBlock Grid.Row="6" Text="After import" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="EdStateBox" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" MinWidth="230"/>
                      <CheckBox x:Name="EdApplyBox" Grid.Row="8" Grid.Column="1" Content="Update this platform if it already exists"
                                ToolTip="Checked: the setting changes, PSM configuration and state below are applied to a platform that already exists. Unchecked: an existing platform is skipped and left exactly as it is."/>
                    </Grid>

                    <DockPanel Margin="0,18,0,6">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SettingAddButton" Content="Add setting" Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                        <Button x:Name="SettingRemoveButton" Content="Remove" Style="{StaticResource SmallButton}"/>
                      </StackPanel>
                      <TextBlock Text="Setting changes" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <DataGrid x:Name="SettingsGrid" MinHeight="110" MaxHeight="260" CanUserAddRows="False" CanUserDeleteRows="False">
                      <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Operation" Width="85" ItemsSource="{StaticResource SettingOperations}"
                                                SelectedItemBinding="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="Setting path" Width="5*" SortMemberPath="Path">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Path=Path}" ToolTip="{Binding Path=Path}" Style="{StaticResource CellText}"/></DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                          <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                              <ComboBox IsEditable="True" IsTextSearchEnabled="False" MinHeight="0" Padding="4,1" BorderThickness="0"
                                        ItemsSource="{DynamicResource SettingPaths}"
                                        Text="{Binding Path=Path, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="New value" Width="2*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                               Text="Double-click a cell to edit. The path list holds common settings; any other path can be typed in. 'remove' ignores the value. Needs PVWA 15.2 or later."/>

                    <TextBlock Text="PSM" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <CheckBox x:Name="EdPsmBox" Content="Set the PSM configuration of this platform"/>
                    <StackPanel x:Name="PsmPanel" Margin="0,8,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PSM server ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EdPsmServerBox" Grid.Column="1" ToolTip="For example PSMServer. Leave empty to keep the platform's current PSM server."/>
                      </Grid>
                      <DockPanel Margin="0,10,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button x:Name="ConnectorAddButton" Content="Add connector" Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                          <Button x:Name="ConnectorRemoveButton" Content="Remove" Style="{StaticResource SmallButton}"/>
                        </StackPanel>
                        <TextBlock Text="Connection components" Foreground="#374151"/>
                      </DockPanel>
                      <DataGrid x:Name="ConnectorsGrid" MinHeight="90" MaxHeight="220" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Connector ID" Width="*" Binding="{Binding PSMConnectorID, UpdateSourceTrigger=PropertyChanged}"
                                              ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
                          <DataGridCheckBoxColumn Header="Enabled" Width="80" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                      </DataGrid>
                      <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                                 Text="For example PSM-SSH or PSM-RDP. Leave the list empty to keep the connectors the platform already has."/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- validation and JSON preview -->
            <Grid Grid.Column="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="96"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" x:Name="ValidationTitle" Text="Checks" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                  <DataGrid x:Name="ValidationGrid" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="None" BorderThickness="0"
                            MaxHeight="190" GridLinesVisibility="None" AlternatingRowBackground="White" ToolTip="Double-click a line to jump to that variant.">
                    <DataGrid.Columns>
                      <DataGridTextColumn Binding="{Binding Severity}" Width="62" ElementStyle="{StaticResource SeverityText}"/>
                      <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="4,3"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
              <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="JSON preview" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                  <TextBox x:Name="JsonPreviewBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#F9FAFB" BorderThickness="0"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextWrapping="NoWrap"/>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
